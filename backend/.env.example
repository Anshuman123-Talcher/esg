# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password@localhost:5433/meil_esg?schema=public"

# Server Port
PORT=5000

# Authentication & Security (Provide strong random secrets at least 32 characters)
JWT_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret
JWT_EXPIRES_IN="24h"

# Environment (development | production)
NODE_ENV="development"

# CORS Allowed Origins (Comma-separated exact origins)
FRONTEND_ORIGIN="http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:8080"

# Upload Directory
UPLOAD_DIR="./uploads"

# Optional Gemini OCR API Key (Leave blank to use internal local OCR provider)
GEMINI_API_KEY=""
